# Server-only. Set the same name in the Vercel project settings.
# Never commit a real key or expose this value to the browser.
GROQ_API_KEY=replace_with_your_groq_api_key

# Optional. Defaults to openai/gpt-oss-120b, the current Groq production
# model on the free and developer tier. llama-3.3-70b-versatile has been
# enterprise-only since 16 August 2026.
# GROQ_MODEL=openai/gpt-oss-120b
