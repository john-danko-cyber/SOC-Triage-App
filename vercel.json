{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/health.ts": { "maxDuration": 300 },
    "api/triage/inspect.ts": { "maxDuration": 300 },
    "api/triage/analyze.ts": { "maxDuration": 300 },
    "api/triage/jobs/inspect.ts": { "maxDuration": 300 },
    "api/triage/jobs/analyze.ts": { "maxDuration": 300 },
    "api/triage/jobs/[jobId].ts": { "maxDuration": 300 },
    "api/[[...path]].ts": { "maxDuration": 300 }
  }
}
